# Environment Variables Template
# Copy this file to .env.local and update the values

# JWT Secret Key (IMPORTANT: Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-long-and-random

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# Database Configuration (when you add a real database)
# DATABASE_URL=postgresql://username:password@localhost:5432/ebus_db
# MONGODB_URI=mongodb://localhost:27017/ebus_db

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Payment Gateway (when implementing payments)
# PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# File Upload (if needed)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=GA_TRACKING_ID
# HOTJAR_ID=your_hotjar_id
