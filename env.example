# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration (Vercel Postgres)
POSTGRES_URL=your_postgres_connection_url_here
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here
POSTGRES_URL_NON_POOLING=your_postgres_non_pooling_url_here
POSTGRES_USER=your_postgres_user
POSTGRES_HOST=your_postgres_host
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=your_postgres_database

# Database Initialization Secret (for security)
DB_INIT_SECRET=your_db_initialization_secret_here

# Admin Credentials (for demo purposes)
ADMIN_EMAIL=admin@techlogix.com
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# Driver Credentials (for demo purposes)  
DRIVER_ID=DRV001
DRIVER_PASSWORD_HASH=your_bcrypt_hashed_password_here

# Email Configuration (for notifications)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# Vercel/Deployment Settings
NEXT_PUBLIC_VERCEL_URL=your-domain.vercel.app
NODE_ENV=production

# Security Settings
BCRYPT_ROUNDS=12
TOKEN_EXPIRY=24h